<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:name=".EprayogshalaApp"
        android:theme="@style/Theme.eprayogshala">

        <activity
            android:name=".ui.activities.HardnessWaterActivity"
            android:exported="true"
            android:label="@string/title_activity_hardness_activity"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".ui.activities.AcidBaseTitration"
            android:exported="true"
            android:label="@string/title_activity_acid_base_titration"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".ui.activities.PdfViewerActivity"
            android:exported="true"
            android:label="@string/title_activity_pdf_viewer"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".SplashScreen"
            android:exported="true"
            android:label="@string/title_activity_splash"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/title_activity_login"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".ui.activities.PHmetricActivity"
            android:exported="true"
            android:label="@string/title_activity_phmetric"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".ui.activities.ColorimetricActivity"
            android:exported="true"
            android:label="@string/title_activity_colorimetric"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".ui.activities.PotentiometricActivity"
            android:exported="true"
            android:label="@string/title_activity_potentio_metric"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".DashBoardActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
        <activity
            android:name=".ui.activities.ConductometricActivity"
            android:exported="true"
            android:label="@string/title_activity_conductometric"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.eprayogshala.NoActionBar" />
    </application>

</manifest>